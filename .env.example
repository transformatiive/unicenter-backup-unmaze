# Copia este ficheiro para .env e preenche com valores reais.
# NUNCA faças commit do teu .env — só este .env.example (com placeholders) vai para o repositório.

# Ligação Postgres.
# Em produção (Railway) esta variável é injetada automaticamente pelo serviço Postgres
# (referência ${{Postgres.DATABASE_URL}}). Localmente aponta para o teu Postgres.
DATABASE_URL=postgres://user:changeme@localhost:5432/unicenter_backup

# Segredo para assinar as sessões. Gera um valor forte, ex: `openssl rand -hex 32`.
SESSION_SECRET=changeme-gera-um-valor-aleatorio-forte

# Utilizador inicial (admin). Só é criado no arranque se a tabela `users` estiver vazia.
SEED_ADMIN_USERNAME=jdias
# NOTA: se a password tiver `#`, envolve-a em aspas — o dotenv trata `#` sem aspas como
# início de comentário e a password fica truncada (ver README). Ex: SEED_ADMIN_PASSWORD="abc#123"
SEED_ADMIN_PASSWORD="changeme"

# Ambiente. Em produção usa `production` (ativa cookies "secure").
NODE_ENV=development

# Porta HTTP (no Railway é injetada automaticamente).
PORT=3000

# Opcional: define como `disable` para desligar SSL na ligação Postgres (ex: Postgres local
# sem SSL). Em produção (Railway) deixa em branco — a ligação usa SSL.
# PGSSLMODE=disable
