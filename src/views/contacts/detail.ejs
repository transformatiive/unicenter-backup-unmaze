<!DOCTYPE html>
<html lang="pt">
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/nav') %>
  <main class="container container-wide">
    <div class="detail-head">
      <a class="btn btn-small" href="/contacts<%= backQuery ? ('?' + backQuery) : '' %>">‹ Voltar à lista</a>
      <h1><%= title %></h1>
      <span class="hint">ID interno: <%= row.id %></span>
    </div>

    <section class="card">
      <h2>Etiquetas e lotes</h2>
      <div class="actions">
        <% if (tags.length) { tags.forEach(function (t) { %><span class="pill"><span class="dot" style="background:<%= t.color %>"></span><%= t.name %></span><% }) } else { %><span class="hint">Sem etiquetas.</span><% } %>
      </div>
      <div class="actions" style="margin-top:10px">
        <% if (batches.length) { batches.forEach(function (b) { %><a class="pill n" href="/lotes/<%= b.id %>" style="text-decoration:none">Lote <%= b.id %>: <%= b.name %></a><% }) } else { %><span class="hint">Ainda não saiu em nenhum lote.</span><% } %>
      </div>
    </section>

    <div class="detail-grid">
      <% groups.forEach(function(group) { %>
        <section class="card detail-card">
          <h2><%= group.title %></h2>
          <dl class="detail-list">
            <% group.fields.forEach(function(f) { %>
              <div class="detail-item">
                <dt><%= f.label %></dt>
                <dd class="<%= (f.value === null || f.value === '') ? 'empty' : '' %>">
                  <%= (f.value === null || f.value === '') ? '—' : f.value %>
                </dd>
              </div>
            <% }) %>
          </dl>
        </section>
      <% }) %>
    </div>
  </main>
</body>
</html>
