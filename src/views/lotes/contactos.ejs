<!DOCTYPE html>
<html lang="pt">
<head><%- include('../partials/head') %></head>
<body>
  <%- include('../partials/nav') %>
  <main>
    <div class="page-head">
      <div class="row">
        <h1>Lote <%= batch.id %> <small class="tn"><%= Number(batch.contact_count).toLocaleString('pt-PT') %> contactos</small></h1>
        <a class="btn" href="/lotes/<%= batch.id %>">Voltar ao lote</a>
      </div>
      <p><%= batch.name %></p>
    </div>
    <div class="page-body">
      <%- include('../partials/contact_rows', { rows: rows }) %>
      <% if (totalPages > 1) { %>
      <div class="pagination-bar"><nav class="pagination">
        <% if (page > 1) { %><a href="?page=<%= page - 1 %>">‹ Anterior</a><% } else { %><span class="disabled">‹ Anterior</span><% } %>
        <span class="pagination-current">Página <strong><%= page.toLocaleString('pt-PT') %></strong> de <%= totalPages.toLocaleString('pt-PT') %></span>
        <% if (page < totalPages) { %><a href="?page=<%= page + 1 %>">Próxima ›</a><% } else { %><span class="disabled">Próxima ›</span><% } %>
      </nav></div>
      <% } %>
    </div>
  </main>
</body>
</html>
